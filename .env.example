# ─── App ───────────────────────────────────────────────
NODE_ENV=development
API_PORT=3001
API_URL=http://localhost:3001
WEB_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# ─── Database ───────────────────────────────────────────
DATABASE_URL=postgresql://postgres:your_db_password@localhost:5432/dentalease_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dentalease_db
DB_USER=postgres
DB_PASS=your_db_password

# ─── Redis ──────────────────────────────────────────────
REDIS_URL=redis://:your_redis_password@localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASS=your_redis_password

# ─── JWT ────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_secret_change_this_too
JWT_REFRESH_EXPIRES_IN=30d

# ─── WhatsApp (Twilio Business API — primary) ──────────
WHATSAPP_PROVIDER=twilio
# PRODUCTION: JWT_SECRET, JWT_REFRESH_SECRET, ENCRYPTION_KEY and WHATSAPP_VERIFY_TOKEN must each be a distinct,
# random value of 32+ characters — the API refuses to start otherwise. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
WHATSAPP_VERIFY_TOKEN=dentalease-verify
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=+14155238886      # without "whatsapp:" prefix

# ─── WhatsApp Template SIDs (from Twilio Content API) ──
# Create these at: console.twilio.com/us1/develop/sms/content-template-builder
WA_TMPL_APT_CONFIRM=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WA_TMPL_REMINDER_48H=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WA_TMPL_REMINDER_24H=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WA_TMPL_CANCELLED=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WA_TMPL_RESCHEDULED=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WA_TMPL_PAYMENT=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WA_TMPL_FOLLOWUP=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WA_TMPL_BROADCAST=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WA_TMPL_RECEIPT=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx   # payment receipt (post-payment)

# ─── WhatsApp (360Dialog — fallback) ───────────────────
WHATSAPP_360DIALOG_API_KEY=your_360dialog_api_key
WHATSAPP_360DIALOG_BASE_URL=https://waba.360dialog.io/v1

# ─── Razorpay ───────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx          # rzp_live_xxx in production
RAZORPAY_KEY_SECRET=your_razorpay_secret
# Webhook secret: Razorpay Dashboard → Webhooks → Secret
# Register URL:   https://your-api.com/api/v1/billing/webhooks/razorpay
# Events to enable: payment.captured, payment.failed, payment_link.paid,
#                   payment_link.partially_paid, refund.processed, refund.failed
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ─── Email (AWS SES) ────────────────────────────────────
SES_REGION=ap-south-1
SES_ACCESS_KEY=your_aws_access_key
SES_SECRET_KEY=your_aws_secret_key
EMAIL_FROM=noreply@dentalease.in

# ─── AWS S3 (documents, X-rays) ─────────────────────────
AWS_REGION=ap-south-1
AWS_S3_BUCKET=dentalease-documents
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# ─── Encryption ─────────────────────────────────────────
ENCRYPTION_KEY=32_char_encryption_key_here_xxxx

# ─── Superadmin (platform owner) ────────────────────────
SUPER_ADMIN_EMAIL=admin@dentalease.in
SUPER_ADMIN_PASSWORD=change_me_in_prod
